{
  "title": "Integration Lab",
  "uid": "integration-lab",
  "timezone": "browser",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "type": "timeseries",
      "title": "GitHub events per hour, by type",
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket('1 hour', created_at) AS time, type AS metric, count(*) AS value FROM github_events WHERE $__timeFilter(created_at) GROUP BY 1, 2 ORDER BY 1",
          "editorMode": "code",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "Ingest lag (s since newest row landed)",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 3600
              },
              {
                "color": "red",
                "value": 86400
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT extract(epoch FROM now() - max(ingested_at)) AS lag_seconds FROM github_events",
          "editorMode": "code",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          }
        }
      ]
    },
    {
      "type": "table",
      "title": "Top actors in range",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT actor, count(*) AS events FROM github_events WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 2 DESC LIMIT 10",
          "editorMode": "code",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          }
        }
      ]
    },
    {
      "type": "table",
      "title": "Webhook deliveries received",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT received_at, event, delivery_id FROM webhook_deliveries ORDER BY received_at DESC LIMIT 20",
          "editorMode": "code",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          }
        }
      ]
    }
  ],
  "schemaVersion": 41
}
